<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magenest\XmlConfiguration\Model\Config\Reader">
        <arguments>
            <argument name="fileName" xsi:type="string">myconfig.xml</argument>
            <argument name="converter" xsi:type="object">Magenest\XmlConfiguration\Model\Config\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">Magenest\XmlConfiguration\Model\Config\SchemaLocator</argument>
        </arguments>
    </type>

    <virtualType name="aclCustomerResourceConfigDataStorage" type="Magento\Framework\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">Magenest\XmlConfiguration\Model\Config\Reader</argument>
            <argument name="cacheId" xsi:type="string">acl_customer_resource_config</argument>
        </arguments>
    </virtualType>

    <type name="Magenest\XmlConfiguration\Model\Config">
        <arguments>
            <argument name="dataStorage" xsi:type="object">aclCustomerResourceConfigDataStorage</argument>
        </arguments>
    </type>
</config>
