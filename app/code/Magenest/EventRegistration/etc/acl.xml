<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magenest_EventRegistration::root" title="Event Registration" sortOrder="40">
                    <resource id="Magenest_EventRegistration::event" title="Manage Events" sortOrder="10">
                        <resource id="Magenest_EventRegistration::event_save" title="Save Event" sortOrder="10"/>
                        <resource id="Magenest_EventRegistration::event_delete" title="Delete Event" sortOrder="20"/>
                    </resource>
                    <resource id="Magenest_EventRegistration::event_register"
                              title="Mass Register Customers to Event" sortOrder="20"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
