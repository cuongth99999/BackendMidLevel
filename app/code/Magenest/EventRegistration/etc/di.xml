<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Magenest\EventRegistration\Api\Data\EventInterface"
                type="Magenest\EventRegistration\Model\Event"/>
    <preference for="Magenest\EventRegistration\Api\Data\EventScheduleInterface"
                type="Magenest\EventRegistration\Model\EventSchedule"/>
    <preference for="Magenest\EventRegistration\Api\EventRepositoryInterface"
                type="Magenest\EventRegistration\Model\EventRepository"/>
    <preference for="Magenest\EventRegistration\Api\EventScheduleRepositoryInterface"
                type="Magenest\EventRegistration\Model\EventScheduleRepository"/>
    <preference for="Magenest\EventRegistration\Api\Data\EventRegistrationInterface"
                type="Magenest\EventRegistration\Model\EventRegistration"/>
    <preference for="Magenest\EventRegistration\Api\EventRegistrationRepositoryInterface"
                type="Magenest\EventRegistration\Model\EventRegistrationRepository"/>
    <preference for="Magenest\EventRegistration\Api\Data\MassRegisterRequestInterface"
                type="Magenest\EventRegistration\Model\Queue\MassRegisterRequest"/>

    <virtualType name="Magenest\EventRegistration\Model\ResourceModel\Event\Grid\Collection"
                 type="Magenest\EventRegistration\Model\ResourceModel\Event\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">magenest_event</argument>
            <argument name="resourceModel" xsi:type="string">Magenest\EventRegistration\Model\ResourceModel\Event</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="magenest_event_listing_data_source" xsi:type="string">
                    Magenest\EventRegistration\Model\ResourceModel\Event\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
</config>
