<?xml version="1.0"?>
<!--
/**
 * app/code/Magenest/AjaxCart/etc/frontend/sections.xml
 *
 * Register our AJAX endpoints with customer-data so the `cart` section
 * (mini-cart, item count, subtotal) is automatically invalidated when the
 * quote is mutated. Belt-and-suspenders alongside the explicit
 * customerData.reload(['cart']) call in ajax-cart.js.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="ajaxcart/cart/ajaxUpdate">
        <section name="cart"/>
    </action>
    <action name="ajaxcart/cart/ajaxDelete">
        <section name="cart"/>
    </action>
</config>