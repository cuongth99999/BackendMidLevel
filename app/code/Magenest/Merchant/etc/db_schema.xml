<?xml version="1.0"?>
<!--
 * app/code/Magenest/Merchant/etc/db_schema.xml
 * Declarative schema for the Merchant EAV entity.
 * After every change regenerate the whitelist via:
 *   bin/magento setup:db-declaration:generate-whitelist  module-name=Magenest_Merchant
-->
<!-- NOTE: lines above the schema element are XML comments only. -->

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- ============================================================== -->
    <!-- Entity table                                                     -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity" resource="default" engine="innodb"
           comment="Magenest Merchant EAV Entity Table">
        <column xsi:type="int"       name="entity_id"        unsigned="true"  nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="smallint"  name="entity_type_id"   unsigned="true"  nullable="false" default="0"     comment="Entity Type ID"/>
        <column xsi:type="smallint"  name="attribute_set_id" unsigned="true"  nullable="false" default="0"     comment="Attribute Set ID"/>
        <column xsi:type="smallint"  name="store_id"         unsigned="true"  nullable="false" default="0"     comment="Store ID"/>
        <column xsi:type="timestamp" name="created_at"       on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at"       on_update="true"  nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCHANT_ENTITY_ENTITY_TYPE_ID"   indexType="btree">
            <column name="entity_type_id"/>
        </index>
        <index referenceId="MAGENEST_MERCHANT_ENTITY_ATTRIBUTE_SET_ID" indexType="btree">
            <column name="attribute_set_id"/>
        </index>
        <index referenceId="MAGENEST_MERCHANT_ENTITY_STORE_ID"         indexType="btree">
            <column name="store_id"/>
        </index>
    </table>

    <!-- ============================================================== -->
    <!-- VARCHAR value table                                              -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity_varchar" resource="default" engine="innodb"
           comment="Merchant EAV - varchar values">
        <column xsi:type="int"     name="value_id"     unsigned="true" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0"    comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id"     unsigned="true" nullable="false" default="0"    comment="Store ID"/>
        <column xsi:type="int"     name="entity_id"    unsigned="true" nullable="false" default="0"    comment="Entity ID"/>
        <column xsi:type="varchar" name="value"        nullable="true"  length="255"                   comment="Value"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_VARCHAR_ATTR_ID_EAV_ATTR_ATTR_ID"
                    table="magenest_merchant_entity_varchar" column="attribute_id"
                    referenceTable="eav_attribute" referenceColumn="attribute_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_VARCHAR_ENT_ID_MAGENEST_MERCH_ENT_ENT_ID"
                    table="magenest_merchant_entity_varchar" column="entity_id"
                    referenceTable="magenest_merchant_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_VARCHAR_STORE_ID_STORE_STORE_ID"
                    table="magenest_merchant_entity_varchar" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="unique" referenceId="MAGENEST_MERCH_VARCHAR_ENT_ID_ATTR_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCH_VARCHAR_ATTR_ID"  indexType="btree"><column name="attribute_id"/></index>
        <index referenceId="MAGENEST_MERCH_VARCHAR_STORE_ID" indexType="btree"><column name="store_id"/></index>
    </table>

    <!-- ============================================================== -->
    <!-- INT value table                                                  -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity_int" resource="default" engine="innodb"
           comment="Merchant EAV - int values">
        <column xsi:type="int"     name="value_id"     unsigned="true" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0"    comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id"     unsigned="true" nullable="false" default="0"    comment="Store ID"/>
        <column xsi:type="int"     name="entity_id"    unsigned="true" nullable="false" default="0"    comment="Entity ID"/>
        <column xsi:type="int"     name="value"        nullable="true"                                  comment="Value"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_INT_ATTR_ID_EAV_ATTR_ATTR_ID"
                    table="magenest_merchant_entity_int" column="attribute_id"
                    referenceTable="eav_attribute" referenceColumn="attribute_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_INT_ENT_ID_MAGENEST_MERCH_ENT_ENT_ID"
                    table="magenest_merchant_entity_int" column="entity_id"
                    referenceTable="magenest_merchant_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_INT_STORE_ID_STORE_STORE_ID"
                    table="magenest_merchant_entity_int" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="MAGENEST_MERCH_INT_ENT_ID_ATTR_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCH_INT_ATTR_ID"  indexType="btree"><column name="attribute_id"/></index>
        <index referenceId="MAGENEST_MERCH_INT_STORE_ID" indexType="btree"><column name="store_id"/></index>
    </table>

    <!-- ============================================================== -->
    <!-- TEXT value table                                                 -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity_text" resource="default" engine="innodb"
           comment="Merchant EAV - text values">
        <column xsi:type="int"     name="value_id"     unsigned="true" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0"    comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id"     unsigned="true" nullable="false" default="0"    comment="Store ID"/>
        <column xsi:type="int"     name="entity_id"    unsigned="true" nullable="false" default="0"    comment="Entity ID"/>
        <column xsi:type="text"    name="value"        nullable="true"                                  comment="Value"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_TEXT_ATTR_ID_EAV_ATTR_ATTR_ID"
                    table="magenest_merchant_entity_text" column="attribute_id"
                    referenceTable="eav_attribute" referenceColumn="attribute_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_TEXT_ENT_ID_MAGENEST_MERCH_ENT_ENT_ID"
                    table="magenest_merchant_entity_text" column="entity_id"
                    referenceTable="magenest_merchant_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_TEXT_STORE_ID_STORE_STORE_ID"
                    table="magenest_merchant_entity_text" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="MAGENEST_MERCH_TEXT_ENT_ID_ATTR_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCH_TEXT_ATTR_ID"  indexType="btree"><column name="attribute_id"/></index>
        <index referenceId="MAGENEST_MERCH_TEXT_STORE_ID" indexType="btree"><column name="store_id"/></index>
    </table>

    <!-- ============================================================== -->
    <!-- DATETIME value table                                             -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity_datetime" resource="default" engine="innodb"
           comment="Merchant EAV - datetime values">
        <column xsi:type="int"      name="value_id"     unsigned="true" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0"    comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id"     unsigned="true" nullable="false" default="0"    comment="Store ID"/>
        <column xsi:type="int"      name="entity_id"    unsigned="true" nullable="false" default="0"    comment="Entity ID"/>
        <column xsi:type="datetime" name="value"        nullable="true"                                  comment="Value"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DATETIME_ATTR_ID_EAV_ATTR_ATTR_ID"
                    table="magenest_merchant_entity_datetime" column="attribute_id"
                    referenceTable="eav_attribute" referenceColumn="attribute_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DATETIME_ENT_ID_MAGENEST_MERCH_ENT_ENT_ID"
                    table="magenest_merchant_entity_datetime" column="entity_id"
                    referenceTable="magenest_merchant_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DATETIME_STORE_ID_STORE_STORE_ID"
                    table="magenest_merchant_entity_datetime" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="MAGENEST_MERCH_DATETIME_ENT_ID_ATTR_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCH_DATETIME_ATTR_ID"  indexType="btree"><column name="attribute_id"/></index>
        <index referenceId="MAGENEST_MERCH_DATETIME_STORE_ID" indexType="btree"><column name="store_id"/></index>
    </table>

    <!-- ============================================================== -->
    <!-- DECIMAL value table                                              -->
    <!-- ============================================================== -->
    <table name="magenest_merchant_entity_decimal" resource="default" engine="innodb"
           comment="Merchant EAV - decimal values">
        <column xsi:type="int"     name="value_id"     unsigned="true" nullable="false" identity="true" comment="Value ID"/>
        <column xsi:type="smallint" name="attribute_id" unsigned="true" nullable="false" default="0"    comment="Attribute ID"/>
        <column xsi:type="smallint" name="store_id"     unsigned="true" nullable="false" default="0"    comment="Store ID"/>
        <column xsi:type="int"     name="entity_id"    unsigned="true" nullable="false" default="0"    comment="Entity ID"/>
        <column xsi:type="decimal" name="value"        scale="4" precision="12" nullable="true"        comment="Value"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DECIMAL_ATTR_ID_EAV_ATTR_ATTR_ID"
                    table="magenest_merchant_entity_decimal" column="attribute_id"
                    referenceTable="eav_attribute" referenceColumn="attribute_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DECIMAL_ENT_ID_MAGENEST_MERCH_ENT_ENT_ID"
                    table="magenest_merchant_entity_decimal" column="entity_id"
                    referenceTable="magenest_merchant_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="MAGENEST_MERCH_DECIMAL_STORE_ID_STORE_STORE_ID"
                    table="magenest_merchant_entity_decimal" column="store_id"
                    referenceTable="store" referenceColumn="store_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="MAGENEST_MERCH_DECIMAL_ENT_ID_ATTR_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="attribute_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="MAGENEST_MERCH_DECIMAL_ATTR_ID"  indexType="btree"><column name="attribute_id"/></index>
        <index referenceId="MAGENEST_MERCH_DECIMAL_STORE_ID" indexType="btree"><column name="store_id"/></index>
    </table>

</schema>
