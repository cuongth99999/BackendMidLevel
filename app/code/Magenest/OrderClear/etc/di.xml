<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="magenest_order_clear" xsi:type="object">Magenest\OrderClear\Console\Command\ClearOrder</item>
            </argument>
        </arguments>
    </type>
    
    <!-- Service Contract for Order Operations -->
    <preference for="Magenest\OrderClear\Model\OrderManagementInterface"
                type="Magenest\OrderClear\Model\OrderManagement"/>
</config>