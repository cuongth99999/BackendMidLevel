<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="business_directory" resource="default" engine="innodb" comment="Business Directory Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="customer_directory" nullable="false" length="255" comment="Customer Directory"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="boolean" name="consumer_frontend" nullable="false" default="false" comment="Consumer Frontend"/>
        <column xsi:type="boolean" name="business_frontend" nullable="false" default="false" comment="Business Frontend"/>
        <column xsi:type="text" name="notes" nullable="true" comment="Notes"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Update Time"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="BUSINESS_DIRECTORY_CUSTOMER_DIRECTORY" indexType="btree">
            <column name="customer_directory"/>
        </index>
    </table>
</schema>